# Copy this file to .env.local and fill in your values.
# See SETUP_GUIDE.md for how to obtain each of these.

# ── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── SignalWire ────────────────────────────────────────────────────────────────
# Space name is the subdomain in your SignalWire dashboard URL (the "yourspace"
# in yourspace.signalwire.com) — NOT your account's display name.
SIGNALWIRE_SPACE=yourspace.signalwire.com
SIGNALWIRE_PROJECT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
SIGNALWIRE_API_TOKEN=PTxxxxxxxx
SIGNALWIRE_DEFAULT_NUMBER=+1XXXXXXXXXX
# SIP domain browser softphones register against for WebRTC calling. This is
# NOT simply "yourspace.sip.signalwire.com" — it includes a project-specific
# suffix (e.g. yourspace-eb135bd8a9a9.sip.signalwire.com). Get the exact value
# from Dashboard -> SIP Endpoints (open any endpoint and look at its full SIP
# URI/domain), or from another already-working SIP client's registrar URI if
# you have one (e.g. a FreeSWITCH trunk config). Guessing this wrong still
# gets a real-looking digest challenge back before failing, so it silently
# looks like a credentials problem instead of a wrong-hostname one.
SIGNALWIRE_SIP_DOMAIN=yourspace-xxxxxxxxxxxx.sip.signalwire.com

# ── Google Sheets CRM (optional — SETUP_GUIDE.md Step 3) ────────────────────
# Entire contents of the service account JSON key file, as one value.
# NEVER put this in a browser-facing setting — it grants write access to
# anything shared with the service account, unlike the AI provider keys below.
GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","client_email":"...","private_key":"...","...":"..."}

# ── Call transcription (optional — SETUP_GUIDE.md Step 3.4) ─────────────────
# Either can also be set per-user in Settings instead of/in addition to here.
DEEPGRAM_API_KEY=
# Base URL of a self-hosted, OpenAI-API-compatible Whisper server. Used as a
# fallback if Deepgram is unset or a request to it fails.
WHISPER_ENDPOINT_URL=

# ── AI voice agent LLM providers (all optional — see README.md) ─────────────
# Every one of these can also be set per-user in Settings. If none are
# configured anywhere, the agent falls back to a small rule-based responder.
CEREBRAS_API_KEY=
REPLICATE_API_TOKEN=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
